# Database
DATABASE_URL=postgresql://flowcomments:flowcomments@localhost:5432/flowcomments

# Redis (opcional, use apenas se quiser usar BullMQ)
# Se não definir, o worker não iniciará, mas o app funcionará
REDIS_URL=redis://localhost:6379

# Criptografia (gerado automaticamente na primeira execução se não existir)
# Use um valor aleatório de 64 caracteres hexadecimais
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session (pode usar o mesmo que ENCRYPTION_KEY)
SESSION_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# Meta/Instagram (configurado via UI no setup, mas pode ser definido aqui também)
# META_APP_ID=seu-app-id
# META_APP_SECRET=seu-app-secret
# META_CONFIG_ID=seu-config-id (opcional)
# WEBHOOK_VERIFY_TOKEN=seu-webhook-token

# Meta Graph API Version
META_GRAPH_API_VERSION=v21.0

# App
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_URL=https://seu-dominio.com
