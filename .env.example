# Database
DATABASE_URL=postgresql://flowcomments:flowcomments@localhost:5432/flowcomments

# Redis (obrigatório em produção: filas, delays longos, recovery, token refresh)
REDIS_URL=redis://localhost:6379

# Uploads de mídia (imagem/áudio). Em Docker/Railway monte um volume neste path.
# FLOWCOMMENTS_UPLOAD_DIR=/app/data/uploads

# REQUIRED in production; never store these in the database
# openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# Meta/Instagram (também configurável via UI no setup)
# META_APP_ID=seu-app-id
# META_APP_SECRET=seu-app-secret
# META_CONFIG_ID=seu-config-id
# WEBHOOK_VERIFY_TOKEN=seu-webhook-token

META_GRAPH_API_VERSION=v21.0

PORT=3000
NODE_ENV=production
NEXT_PUBLIC_URL=https://seu-dominio.com

# Updates (self-hosted) — ativas por padrão no template Railway
# Repo usado para checar releases no GitHub
FLOWCOMMENTS_UPDATE_REPO=NathanConde-dev/flowcomments
# Override da versão local (útil p/ simular updateAvailable; senão usa package.json)
# FLOWCOMMENTS_LOCAL_VERSION=0.1.0
# Token GitHub se o repo for privado (senão o check cai no control plane)
# FLOWCOMMENTS_GITHUB_TOKEN=
# One-click no painel (só VPS/host com scripts/update.sh). Nunca ligue em Railway.
ENABLE_SELF_UPDATE=false

# Control plane (Flowcomments Cloud)
# Comunicados + feed de releases (/api/v1/releases) + telemetria anônima
FLOWCOMMENTS_CONTROL_PLANE_URL=https://flowcomments.com
# Telemetria anônima (install id, versão, host, contagem IG). Desligar: false
FLOWCOMMENTS_TELEMETRY=true

# Grupo WhatsApp da comunidade open source (toast de engajamento no app)
# NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/...
