# Railway Environment Variables Template
# Copy these to your Railway service variables

# ============================================
# REQUIRED (Railway auto-generates DATABASE_URL)
# ============================================

# Railway provides automatically:
# DATABASE_URL=postgresql://...

# You must set:
NEXT_PUBLIC_URL=https://your-app.railway.app

# ============================================
# OPTIONAL
# ============================================

# Redis (optional - if not set, uses in-process fallback)
# REDIS_URL=redis://...

# Encryption (optional - auto-generated and saved in DB if not set)
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session secret (optional - uses ENCRYPTION_KEY if not set)
# SESSION_SECRET=your-secret-here-minimum-32-chars

# Meta API version (optional - defaults to v21.0)
# META_GRAPH_API_VERSION=v21.0

# Worker mode (optional - defaults to true)
# Set to false if running worker as separate service
# RUN_WORKER=true

# Port (Railway sets automatically, do not override)
# PORT=3000
