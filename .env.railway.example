# Railway Environment Variables (1-click template / manual deploy)
#
# No template Railway, use referências ${{...}} para amarrar Postgres/Redis.
# Valores abaixo são o padrão do template Flowcomments.

# ============================================
# REQUIRED (auto no template)
# ============================================

# Postgres gerenciado pelo Railway
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis gerenciado pelo Railway (obrigatório: worker, filas, delays longos, recovery)
REDIS_URL=${{Redis.REDIS_URL}}

# Uploads persistentes — monte um Volume no serviço em /app/data/uploads
FLOWCOMMENTS_UPLOAD_DIR=/app/data/uploads

# URL pública do app (domínio gerado pelo Railway)
NEXT_PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Secrets gerados no deploy do template
ENCRYPTION_KEY=${{secret(64, "0123456789abcdef")}}
SESSION_SECRET=${{secret(64, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}

# ============================================
# UPDATES / NOVIDADES (ativas no template)
# ============================================
# Painel "Novidades" checa releases no GitHub; se o repo for privado/rate-limit,
# cai no feed do control plane (FLOWCOMMENTS_CONTROL_PLANE_URL).

FLOWCOMMENTS_UPDATE_REPO=NathanConde-dev/flowcomments
FLOWCOMMENTS_CONTROL_PLANE_URL=https://flowcomments.com
# Versão reportada pelo install (opcional; default = package.json)
# FLOWCOMMENTS_LOCAL_VERSION=0.1.0
# Token só se o repo for privado e quiser checar GitHub direto (senão use o control plane)
# FLOWCOMMENTS_GITHUB_TOKEN=
# NUNCA ligue one-click update no Railway (sem acesso ao host/git/docker)
ENABLE_SELF_UPDATE=false
# Telemetria anônima de install → control plane
FLOWCOMMENTS_TELEMETRY=true

# ============================================
# OPTIONAL
# ============================================

# Worker embutido no mesmo container (start.sh). Default: true
RUN_WORKER=true

# META_GRAPH_API_VERSION=v21.0

# PORT é definido pelo Railway — não sobrescreva
